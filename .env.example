# --- Database (required) ---
DATABASE_URL="postgresql://USER@localhost:5432/marketpulse"

# --- Application access ---
# If set, the app requires this password (signed cookie). Empty = open access (use only locally).
APP_PASSWORD=""
# Session cookie signing secret (long random string)
SESSION_SECRET=""

# --- AI ---
# "claude-cli" (free with a Claude subscription, via `claude -p`) | "none"
AI_PROVIDER="claude-cli"
CLAUDE_BIN="claude"
CLAUDE_MODEL="sonnet"
# Max number of automatic AI analyses per hour (protects your subscription quotas)
AI_MAX_AUTO_ANALYSES_PER_HOUR="6"

# --- Optional sources ---
# SEC EDGAR requires an identifying User-Agent with a contact email (SEC rule).
# E.g.: "MarketPulse personal contact@example.com". Empty = SEC source disabled.
SEC_USER_AGENT=""
# Free FRED key (https://fred.stlouisfed.org/docs/api/api_key.html): actual US values (CPI, NFP, unemployment...)
FRED_API_KEY=""

# --- External notifications (optional) ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
ALERT_EMAIL_TO=""

# --- Worker ---
QUOTES_INTERVAL_SEC="60"
NEWS_INTERVAL_SEC="180"
CALENDAR_INTERVAL_SEC="1800"
