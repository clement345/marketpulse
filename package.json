{
  "name": "marketpulse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "worker": "tsx src/worker/index.ts",
    "worker:once": "tsx src/worker/index.ts --once",
    "dev:all": "concurrently -k -n web,worker -c cyan,magenta \"npm:dev\" \"npm:worker\"",
    "start:all": "concurrently -k -n web,worker -c cyan,magenta \"npm:start\" \"npm:worker\"",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "6.9.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fast-xml-parser": "5.2.3",
    "lightweight-charts": "5.0.7",
    "lucide-react": "0.511.0",
    "next": "15.5.29",
    "nodemailer": "7.0.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-resizable-panels": "3.0.2",
    "swr": "2.3.3",
    "tailwind-merge": "3.3.0",
    "zod": "3.25.42"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.8",
    "@types/node": "22.15.29",
    "@types/nodemailer": "6.4.17",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.5",
    "concurrently": "9.1.2",
    "dotenv": "16.5.0",
    "prisma": "6.9.0",
    "tailwindcss": "4.1.8",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vitest": "3.1.4"
  }
}
